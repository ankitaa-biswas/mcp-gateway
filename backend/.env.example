# Server Port
PORT=4000

# Node Environment (development | production)
NODE_ENV=development

# JWT Secret for signing authentication tokens
# In production, use a strong 256-bit randomly generated string
JWT_SECRET=super_secret_jwt_key_for_development

# 32-byte (64 char hex) key used for AES-256-GCM Vault Encryption
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
